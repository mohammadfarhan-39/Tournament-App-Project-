</div>

    <!-- Tournament Details Page -->
    <div id="tournamentDetailsPage" class="details-page">
        <div class="details-header">
            <div class="details-header-content">
                <button class="back-btn" onclick="closeTournamentDetails()">
                    <i class="fas fa-arrow-left"></i>
                </button>
                <div class="details-title" id="detailsPageTitle">Tournament Details</div>
            </div>
        </div>
        <div class="details-content" id="tournamentDetailsContent"></div>
