        <i class="fas fa-home"></i>
    </div>
    <div class="nav-item" onclick="switchPage('tournaments')">
        <i class="fas fa-gamepad"></i>
    </div>
    <div class="nav-item" onclick="switchPage('notifications')">
        <i class="fas fa-bell"></i>
    </div>
