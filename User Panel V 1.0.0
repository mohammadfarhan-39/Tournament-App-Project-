</div>

            <!-- Tournaments Page -->
<!-- এটি শুধু টুর্নামেন্ট পেজের জন্য -->
<div id="tournamentsPage" class="page">
    <div class="section-title">
        <i class="fas fa-gamepad"></i>
        All Tournaments
    </div>

    <!-- ট্যাব সিস্টেম -->
    <div class="dt-tabs" style="margin-bottom: 20px;">
        <div id="t-tab-upcoming" class="dt-tab active" onclick="switchTournamentTab('upcoming')">Upcoming</div>
        <div id="t-tab-live" class="dt-tab" onclick="switchTournamentTab('live')">Live</div>
        <div id="t-tab-joined" class="dt-tab" onclick="switchTournamentTab('joined')">Joined</div>
    </div>

    <!-- শুধু এই ডিভ এর ভেতর টুর্নামেন্ট লিস্ট থাকবে -->
    <div id="tournamentsList"></div> 
</div> <!-- এই ক্লোজিং ট্যাগটি খুব জরুরি -->
            
            

            <!-- Notifications Page -->
            <div id="notificationsPage" class="page">
                <div class="section-title">
                    <i class="fas fa-bell"></i>
                    Notifications
                </div>
                <div id="notificationsList">
                    <div class="empty-state">
                        <i class="fas fa-bell-slash"></i>
                        <p>No notifications</p>
                    </div>
                </div>
            </div>

            <!-- Wallet Page -->
            <div id="walletPage" class="page">
                <div class="card">
                    <div style="text-align: center; margin-bottom: 24px;">
                        <div style="font-size: 14px; color: var(--text-sub); margin-bottom: 8px;">Current Balance</div>
                        <div style="font-size: 36px; font-weight: 800; color: var(--primary);">
                            ৳<span id="walletBalance">0</span>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <button class="btn btn-primary" onclick="showDepositModal()">
                            <i class="fas fa-plus-circle"></i> Deposit
                        </button>
                        <button class="btn btn-danger" onclick="showWithdrawModal()">
                            <i class="fas fa-minus-circle"></i> Withdraw
                        </button>
                    </div>
                </div>

 <!-- নতুন ওয়ালেট ট্যাব সিস্টেম -->
    <div class="dt-tabs" style="margin-bottom: 20px;">
        <div id="w-tab-all" class="dt-tab active" onclick="switchWalletTab('all')">All</div>
        <div id="w-tab-deposit" class="dt-tab" onclick="switchWalletTab('deposit')">Deposit</div>
        <div id="w-tab-withdraw" class="dt-tab" onclick="switchWalletTab('withdraw')">Withdraw</div>
        <div id="w-tab-pending" class="dt-tab" onclick="switchWalletTab('pending')">Pending</div>
    </div>


                <div class="section-title">
                    <i class="fas fa-history"></i>
                    Transaction History
                </div>
                <div id="transactionHistory">
                    <div class="empty-state">
                        <i class="fas fa-receipt"></i>
                        <p>No transactions yet</p>
                    </div>
                </div>
            </div>

            <!-- ১. এটি খুঁজুন <div id="accountPage" class="page"> এবং এর ভেতরের সবটুকু নিচের কোড দিয়ে বদলে দিন -->
<div id="accountPage" class="page">
    
    
    
    <!-- শুধু এই অংশটুকু মিলিয়ে ঠিক করুন, ইনলাইন কালারগুলো সরিয়ে দিয়েছি -->
<div class="profile-glass-card">
    <div class="profile-img-box">
        <i class="fas fa-user"></i>
    </div>
    <div class="profile-info-text">
        <!-- এখানে আগে color: #fff ছিল, সেটা মুছে দিয়েছি -->
        <div id="uGameName" style="font-weight: 800; font-size: 20px; letter-spacing: 1px;">Game Name</div>
        <div id="uAccName" style="font-size: 14px; opacity: 0.8; margin-top: 2px;">Account Name</div>
        <div id="uPhone" style="font-size: 14px; opacity: 0.8;">01XXXXXXXXX</div>
    </div>
</div>

<div class="new-stat-grid">
    <div class="stat-box">
        <small>Total Kills</small>
        <div id="statKills">0</div> <!-- এখানে কোনো স্টাইল থাকবে না -->
    </div>
    <div class="stat-box">
        <small>Match Wins</small>
        <div id="statWins">0</div>
    </div>
    <div class="stat-box">
        <small>Earning</small>
        <div id="statEarning">৳0</div>
    </div>
    <div class="stat-box">
        <small>Positions</small>
        <div id="statRank">#0</div>
    </div>
    <div class="stat-box">
        <small>Match Loss</small>
        <div id="statLoss">0</div>
    </div>
    <div class="stat-box">
        <small>Ac Status</small>
        <div id="statStatus">Active</div>
    </div>
</div>

                <div class="settings-section-title">Account Settings</div>
                <div class="settings-group">
                    <div class="settings-item" onclick="openModal('editProfileModal')">
                        <div class="s-icon-box icon-profile"><i class="fas fa-user"></i></div>
                        <div class="s-content"><div class="s-title">Edit Profile</div><div class="s-desc">Update info</div></div>
                        <i class="fas fa-chevron-right s-arrow"></i>
                    </div>
                    
 
                    <!-- এই কোডটি সেটিংস মেনুর ভেতরে বসান -->
<div class="settings-item" onclick="openModal('themeSelectorModal')">
    <div class="s-icon-box" style="background: rgba(99, 102, 241, 0.1); color: #6366f1;">
        <i class="fas fa-palette"></i>
    </div>
    <div class="s-content">
        <div class="s-title">App Theme</div>
        <div class="s-desc"f>Switch between Normal & Premium</div>
    </div>
    <i class="fas fa-chevron-right s-arrow"></i>
</div>
                  
     <!-- Global Leaderboard Button -->
<div class="settings-item" onclick="showLeaderboard()">
    <div class="s-icon-box" style="background: rgba(251, 191, 36, 0.1); color: #fbbf24;">
        <i class="fas fa-trophy"></i>
    </div>
    <div class="s-content">
        <div class="s-title">Global Leaderboard</div>
        <div class="s-desc">Check top player rankings</div>
    </div>
    <i class="fas fa-chevron-right s-arrow"></i>
</div>

                <!-- Dark Mode Toggle -->
<!-- শুধু এই id="darkModeItem" টুকু যোগ করুন আপনার ডার্ক মোড বাটনে -->
<div class="settings-item" onclick="toggleTheme()">
    <div class="s-icon-box" style="background: rgba(55, 65, 81, 0.1); color: #4b5563;">
        <i class="fas fa-moon"></i>
    </div>
    <div class="s-content">
        <div class="s-title">Dark Mode</div>
        <div class="s-desc">Switch between light/dark theme</div>
    </div>
    <div class="toggle-switch">
        <div class="toggle-slider"></div>
    </div>
</div>
                
                <div class="settings-item" onclick="openModal('editProfileModal')">
                        <div class="s-icon-box icon-key"><i class="fas fa-key"></i></div>
                        <div class="s-content"><div class="s-title">Reset Password</div><div class="s-desc">Change password</div></div>
                        <i class="fas fa-chevron-right s-arrow"></i>
                    </div>
